{
  "expo": {
    "name": "KeepYourSeed",
    "slug": "KeepYourSeed",
    "scheme": "keepyourseed",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/b7f4ff35-a30f-4cf1-afa0-86cca58d7f85",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "orientation": "portrait",
    "icon": "./assets/oragnicKYS.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/oragnicKYS.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAF7F2"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/oragnicKYS.png",
        "backgroundColor": "#FAF7F2"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "package": "com.tianyr.KeepYourSeed"
    },
    "web": {
      "favicon": "./assets/oragnicKYS.png",
      "bundler": "metro",
      "output": "single",
      "backgroundColor": "#FAF7F2",
      "description": "Conserve tes pensées comme des graines précieuses.",
      "display": "standalone",
      "lang": "fr",
      "name": "KeepYourSeed",
      "shortName": "KYS",
      "themeColor": "#78350F"
    },
    "experiments": {
      "baseUrl": "/kys-web-app"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "Allow KeepYourSeed to access your microphone."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Allow KeepYourSeed to access your microphone."
        }
      ],
      "expo-web-browser",
      "expo-updates"
    ],
    "extra": {
      "eas": {
        "projectId": "b7f4ff35-a30f-4cf1-afa0-86cca58d7f85"
      }
    }
  }
}
